rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ★ 把下面的 Email 換成設計師登入用的 Email（APP 裡「資料庫安全規則」會自動帶入）
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'stylist@example.com';
    }
    // 通知機器人：只能讀取，用來發 LINE／Email 通知
    function isBot() {
      return request.auth != null && request.auth.token.email == 'notify-bot@tony-teacher.app';
    }
    match /public/{doc} { allow read: if true; allow write: if isOwner(); }
    match /busy/{date} { allow read: if true; allow write: if isOwner(); }
    match /holds/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['date','s','e','createdAt'])
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.s is int && request.resource.data.e is int
        && request.resource.data.e > request.resource.data.s && request.resource.data.e - request.resource.data.s <= 720
        && request.resource.data.createdAt is int;
      allow delete: if isOwner();
    }
    match /requests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['date','start','duration','price','services','name','phone','note','status','createdAt','holdId','editKey','editOf','prevText'])
        && (!('editKey' in request.resource.data) || (request.resource.data.editKey is string && request.resource.data.editKey.size() >= 16 && request.resource.data.editKey.size() <= 64))
        && (!('editOf' in request.resource.data) || (request.resource.data.editOf is string && request.resource.data.editOf.size() <= 64))
        && (!('prevText' in request.resource.data) || (request.resource.data.prevText is string && request.resource.data.prevText.size() <= 80))
        && request.resource.data.status == 'pending'
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.start is string && request.resource.data.start.size() == 5
        && request.resource.data.duration is int && request.resource.data.duration > 0 && request.resource.data.duration <= 720
        && request.resource.data.price is number
        && request.resource.data.services is list && request.resource.data.services.size() <= 10
        && request.resource.data.name is string && request.resource.data.name.size() <= 30
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 15
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt is int;
      allow read, update, delete: if isOwner();
    }
    match /{coll}/{id} {
      allow read, write: if isOwner();
      allow read: if isBot() && coll in ['settings', 'bookings', 'requests'];
    }
  }
}
